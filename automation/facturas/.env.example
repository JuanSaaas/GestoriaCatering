# Copiar a automation/facturas/.env. Nunca utilizar NEXT_PUBLIC_ para secretos.
OPENROUTER_API_KEY=
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
FACTURAS_INPUT_DIR=.data/facturas/entrada
# Gemini 2.5 Flash siempre se antepone a esta lista.
FACTURAS_FALLBACK_MODELS=google/gemini-2.5-pro,anthropic/claude-sonnet-4.6,openai/gpt-4.1
FACTURAS_POLL_SECONDS=15
FACTURAS_REQUEST_TIMEOUT=90
FACTURAS_RETRIES_PER_MODEL=1
FACTURAS_MAX_FILE_ATTEMPTS=5
FACTURAS_MAX_FILE_MB=20
FACTURAS_MAX_PAGES=20
FACTURAS_MAX_TEXT_CHARS=80000
FACTURAS_MAX_OUTPUT_TOKENS=6000
FACTURAS_OCR_LANGUAGE=spa+eng
# Opcional en Windows: ruta completa al tesseract.exe instalado.
TESSERACT_CMD=
