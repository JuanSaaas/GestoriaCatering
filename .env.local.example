# Copia este archivo como .env.local y rellena con los datos de tu proyecto
# de Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLISHABLE_AQUI

# Acceso al CRM (ver CRM_README.md). Cambia estos tres valores antes de
# publicar; si no se definen, el sistema usa admin / 1234 como valores
# de desarrollo.
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=1234
CRM_SESSION_TOKEN=cambia-esto-por-una-cadena-larga-y-aleatoria
